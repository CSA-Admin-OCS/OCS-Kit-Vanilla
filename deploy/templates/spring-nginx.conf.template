# Nginx reverse proxy for the OCS Kit Spring backend.
#
# Render with your domain (only ${SITE_DOMAIN} is substituted; nginx's own $variables are kept):
#   SITE_DOMAIN=api.example.org envsubst '${SITE_DOMAIN}' \
#     < deploy/nginx.conf.template > /etc/nginx/sites-available/ocs-spring.conf
# Then obtain a certificate, e.g.: sudo certbot --nginx -d api.example.org
#
# Ports: 8585 is the main HTTP connector; 8589 serves the group-chat STOMP websocket.
# CORS is handled by Spring (CORS_ORIGINS in .env), so nginx just proxies.

server {
    server_name ${SITE_DOMAIN};
    client_max_body_size 50M;

    location / {
        proxy_pass http://localhost:8585;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # Native websocket handler on the main connector
    location /websocket {
        proxy_pass http://localhost:8585;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_read_timeout 86400;
    }

    # Group chat (STOMP) on the second connector
    location /ws-chat {
        proxy_pass http://localhost:8589;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
        proxy_send_timeout 86400;
        proxy_buffering off;
    }

    listen 80;
    listen [::]:80;
    # certbot --nginx adds the 443/ssl listeners, certificate paths and an http->https redirect here.
}
