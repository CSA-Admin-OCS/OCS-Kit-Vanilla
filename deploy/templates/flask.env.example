# OCS Kit - Flask backend configuration
# Copy to .env and fill in values:  cp .env.example .env
# Empty values use the default described in the comment. Never commit your real .env.

# ---------------------------------------------------------------------------
# School / site identity
# ---------------------------------------------------------------------------
# Name shown in the admin pages (default: OCS Kit)
SCHOOL_NAME=
# Base domain of your deployment, e.g. example.org (used by nginx templates and admin search)
SITE_DOMAIN=
# URL of your frontend (Pages) site (default: http://localhost:4500)
FRONTEND_URL=
# Comma-separated list of origins allowed to call the API with cookies
# (default: http://localhost:4500,http://127.0.0.1:4500,http://localhost:4000,http://127.0.0.1:4000)
# Example: https://pages.example.org,https://example.github.io
CORS_ORIGINS=
# Domain for the login cookie in production, e.g. .example.org so pages.example.org and
# flask.example.org share it. Empty = host-only cookie.
COOKIE_DOMAIN=
# Comma-separated email domains allowed at signup, e.g. example.org,students.example.org (empty = any)
ALLOWED_EMAIL_DOMAINS=
# Optional admin-page branding
SCHOOL_LOGO_URL=
SOCIAL_GITHUB_URL=
SOCIAL_TWITTER_URL=
SOCIAL_YOUTUBE_URL=

# ---------------------------------------------------------------------------
# Kit and features (see README "Choosing a kit"; ids are in kits/catalog.json)
# ---------------------------------------------------------------------------
# Preset: vanilla  core only, safe for students        roles Admin / Editor / User
#         education CS classroom (lessons, code runners, assignments, AI grading, hall pass...)
#                                                         roles Admin / Teacher / Student
#         business  core + AI chatbot, social, calendar, analytics, resume
#                                                         roles Admin / Manager / Member
# Empty = every feature (as before kits existed). 'core' (accounts, sections, admin) is always on.
KIT=
# Optional changes to the kit (restart after changing):
#   +id,-id      add/remove relative to KIT, e.g. KIT=business FEATURES=+hallpass,-resume
#   +*           the kit plus every other feature
#   id,id        an explicit list that replaces KIT, e.g. FEATURES=ai-chatbot,social
#   *            every feature; *,-kasm = every feature except Kasm
# Feature ids: core lessons code-runner assignments game-engine ai-chatbot ai-grading social
#              calendar analytics hallpass finance-sim resume kasm face-recognition examples
# On top of this, the admin account can turn features on/off at runtime (no restart):
# PUT /api/kit/admin/features. GET /api/kit/admin shows each feature's setup status.
# The admin can also apply a whole kit at runtime: PUT /api/kit/admin/kit. KIT and FEATURES
# are then ignored until DELETE /api/kit/admin/kit returns to them. Accounts and data are kept.
# Check the result with: python -m features --list   (or GET /api/kit)
FEATURES=

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Set to true on a public server: secure cookies, and SECRET_KEY / ADMIN_PASSWORD /
# DEFAULT_PASSWORD become required (the app refuses to start without them)
IS_PRODUCTION=false
# Long random string used to sign sessions and JWTs. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# If empty in development, a random key is generated at startup (logins reset on restart).
SECRET_KEY=
SESSION_COOKIE_NAME=sess_python_flask
JWT_TOKEN_NAME=jwt_python_flask
# JWT/cookie lifetime in seconds (default: 604800 = 1 week)
JWT_TOKEN_MAX_AGE=604800
# Shared secret for password-reset tokens issued by the Spring backend (must match Spring's
# RESET_TOKEN_SECRET). Empty disables the reset-password endpoint.
RESET_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Seeded accounts (created by scripts/db_init.py on first boot)
# Every password must follow the password rule: 8+ characters with an uppercase letter, a
# lowercase letter, a number and one of ` ~ ! @ # $ % ^ & * ( ) (same rule as Spring and Pages).
# In development an unset password falls back to "123Qwerty!". In production
# ADMIN_PASSWORD and DEFAULT_PASSWORD are required; the others fall back to DEFAULT_PASSWORD.
# DEFAULT_PASSWORD is also what an admin "reset password" sets a user's password to.
# ---------------------------------------------------------------------------
# One seeded account per role. Empty uid/name = the kit's defaults (kits/catalog.json):
#   vanilla: admin / editor (staff) / user      education: admin / teacher (staff) / student
#   business: admin / manager (staff) / member   KIT unset: admin / teacher / user
# ADMIN_* is the admin role, TEACHER_* the staff role, USER_* the member role.
DEFAULT_PASSWORD=
DEFAULT_PFP=default.png

ADMIN_USER=
ADMIN_UID=
ADMIN_PASSWORD=
ADMIN_PFP=default.png

TEACHER_USER=
TEACHER_UID=
TEACHER_PASSWORD=
TEACHER_PFP=default.png

USER_NAME=
USER_UID=
USER_PASSWORD=
USER_PFP=default.png

# Optional extra "convenience" account (e.g. for the person maintaining the server)
MY_NAME=convenience
MY_UID=convenience
MY_PASSWORD=
MY_PFP=default.png
MY_ROLE=

# ---------------------------------------------------------------------------
# Database
# Leave DB_* empty to use SQLite at instance/volumes/user_management.db.
# Set all three to use MySQL (database name: user_management, port 3306).
# ---------------------------------------------------------------------------
DB_ENDPOINT=
DB_USERNAME=
DB_PASSWORD=
# true = (re)initialize the database on container start. DESTRUCTIVE: drops all tables.
# SQLite is initialized automatically when the database file does not exist.
DB_INIT=false

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
FLASK_PORT=8587
RUNNER_PORT=8591

# ---------------------------------------------------------------------------
# Optional integrations (each feature is inactive when its settings are empty)
# ---------------------------------------------------------------------------
# GitHub API token (raises rate limits for signup GitHub checks; needed for feedback issues)
GITHUB_TOKEN=
# GitHub org/user used for analytics ('user' or 'organization' + name)
GITHUB_TARGET_TYPE=user
GITHUB_TARGET_NAME=
# Repo ('owner/name') that receives user feedback as GitHub issues
FEEDBACK_GITHUB_REPO=

# Google Gemini (AI chat features)
GEMINI_API_KEY=
GEMINI_SERVER=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent

# Groq (AI chat features)
GROQ_API_KEY=
GROQ_SERVER=https://api.groq.com/openai/v1/chat/completions

# Kasm Workspaces (virtual desktops)
KASM_SERVER=
KASM_API_KEY=
KASM_API_KEY_SECRET=

# Skill snapshot automator service
AUTOMATOR_URL=http://localhost:8586
AUTOMATOR_API_KEY=

# ---------------------------------------------------------------------------
# Maintenance scripts (scripts/db_*.py)
# ---------------------------------------------------------------------------
# Production server that db_migrate-prod2sqlite.py / db_restore-sqlite2prod.py talk to
FLASK_BASE_URL=http://localhost:8587
# Answer "yes" to destructive prompts (used by entrypoint.sh)
FORCE_YES=false
# Allow dropping the database even if a backup could not be taken
ALLOW_NO_BACKUP=false
# Allow a migration to continue with an incomplete export
ALLOW_PARTIAL_EXPORT=false
