# OCS-in-a-Kit: Spring backend configuration
# Copy to .env and fill in. Never commit .env.
# Lines marked REQUIRED must be set or the app refuses to start / seed.

# ---------- School ----------
SCHOOL_NAME=My School CS
# Optional logo URL for the admin nav (defaults to the bundled kit logo)
SCHOOL_LOGO_URL=
# Public URL of the kit's Pages (frontend) site, no trailing slash
FRONTEND_URL=http://localhost:4500
# Public domain of this backend (used by deploy/nginx.conf.template)
SITE_DOMAIN=api.example.org
# Comma-separated origins allowed to call the API with cookies (wildcards OK: https://*.example.org)
CORS_ORIGINS=http://localhost:4500,http://127.0.0.1:4500,http://localhost:4000,http://localhost:8585
# Domain attribute for the login cookie, e.g. .example.org to share it across subdomains.
# Leave empty for a host-only cookie (always the case for localhost).
COOKIE_DOMAIN=
# Comma-separated student email domains for Google-based password reset, e.g. students.example.org
# Empty = any domain, but the Google email must then equal the account's email.
ALLOWED_EMAIL_DOMAINS=

# Login cookie names. Change them when another deployment shares the parent domain (same
# COOKIE_DOMAIN), otherwise the two overwrite each other's logins.
JWT_TOKEN_NAME=jwt_java_spring
SESSION_COOKIE_NAME=sess_java_spring

# ---------- Kit and features ----------
# Preset: vanilla (accounts, profile, blog), education (full CS classroom) or business
# (organizations, no classroom features). Unset = every feature on.
KIT=education
# Optional adjustments, comma separated (ids: core lessons code-runner assignments game-engine
# ai-chatbot ai-grading social calendar analytics hallpass finance-sim resume kasm
# face-recognition examples):
#   FEATURES=+finance-sim,-hallpass   add/remove relative to KIT
#   FEATURES=lessons,code-runner      explicit list (core is always on)
#   FEATURES=*                        everything
# Admins can also turn features on/off at runtime (PUT /api/kit/admin/features); that wins.
# They can also apply a whole kit at runtime (PUT /api/kit/admin/kit). While a kit is applied,
# KIT and FEATURES here are ignored; DELETE /api/kit/admin/kit returns to them.
FEATURES=

# ---------- Security (REQUIRED) ----------
# Base64, >= 32 bytes decoded. Generate: openssl rand -base64 48
JWT_SECRET=
# Signs password-reset tokens (shared with the Flask backend); password reset fails without it.
# Generate: openssl rand -hex 32
RESET_TOKEN_SECRET=
# true = local development only: a random JWT secret is generated when JWT_SECRET is empty
KIT_DEV_MODE=false

# ---------- Seed accounts (created on first boot of an empty database) ----------
# Passwords need 8+ chars with upper, lower, digit and symbol.
# Seed accounts: one per role (admin, staff, member). Uid/name/email default to the kit's
# (education: admin/teacher/student, business: admin/manager/member, vanilla: admin/editor/user);
# uncomment to override.
ADMIN_UID=admin
ADMIN_NAME=Admin User
# Also owns the seeded bathroom/student queues and appears as the contact email.
ADMIN_EMAIL=admin@example.org
# REQUIRED
ADMIN_PASSWORD=
ADMIN_SID=9999990
ADMIN_PFP=/images/default.png
# Staff account (Teacher / Manager / Editor)
# TEACHER_UID=teacher
# TEACHER_NAME=Teacher User
# TEACHER_EMAIL=teacher@example.org
# REQUIRED
TEACHER_PASSWORD=
TEACHER_SID=9999998
TEACHER_PFP=/images/default.png
# Member account (Student / Member / User)
# USER_UID=student
# USER_NAME=Student User
# USER_EMAIL=student@example.org
# optional, defaults to DEFAULT_PASSWORD
USER_PASSWORD=
USER_SID=9999999
USER_PFP=/images/default.png
# Optional extra admin account seeded alongside the above
MY_UID=myuser
MY_NAME=My User
MY_EMAIL=myuser@example.org
MY_SID=9999993
# Password for sample students, and what admin "reset password" sets an account to. REQUIRED
DEFAULT_PASSWORD=

# ---------- Database ----------
# Unset = SQLite at volumes/sqlite.db. For MySQL uncomment and set all three.
# (Leave these commented rather than empty: an empty DB_URL is not "unset".)
# DB_URL=jdbc:mysql://db-host:3306/ocs
# DB_USERNAME=
# DB_PASSWORD=
# Hibernate schema mode. Unset = "update" when the SQLite file is new, otherwise "none".
# Set to "update" for the first boot against an empty MySQL database.
# DDL_AUTO=update

# ---------- Email (optional) ----------
# formsubmit (default) or smtp
EMAIL_PROVIDER=formsubmit
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_REPLY_TO=
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
FORM_SUBMIT_ENDPOINT=https://formsubmit.co/ajax/{recipient}
FORM_SUBMIT_ORIGIN=
FORM_SUBMIT_REFERER=
FORWARD_EMAIL=
FORWARD_PERSON_UID=
# owner:email pairs, e.g. alice:alice@example.org,bob:bob@example.org
ISSUE_OWNER_EMAIL_MAP=

# ---------- Optional integrations (features disable themselves when empty) ----------
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TOKEN=
GIST_TOKEN=
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
CHATTER_MODEL_URL=
STOCKS_HISTORY_API_URL=
# Pages bot account for assignment sync; provisioning is off while the password is empty
PAGES_BOT_UID=pages-bot
PAGES_BOT_EMAIL=pages-bot@example.org
PAGES_BOT_PASSWORD=

# ---------- Code runner ----------
JAVA_RUNNER_URL=http://code_runner:8592
# remote = always use the runner container (set by the image, which has no javac).
# Otherwise only IS_PRODUCTION=true does; a bare local "mvnw spring-boot:run" compiles in-process.
# CODE_RUNNER=remote
IS_PRODUCTION=false

# ---------- Maintenance tools ----------
# Another instance's /api/exports/getAll, used by DatabaseMigrator --import-remote. Empty disables it.
MIGRATION_SOURCE_URL=
# Skip confirmation prompts in DatabaseInitializer / DatabaseMigrator
FORCE_YES=

# ---------- Local HTTP development ----------
# Browsers drop Secure/SameSite=None cookies over plain http. Uncomment for http://localhost:
# jwt.cookie.secure=false
# jwt.cookie.same-site=Lax
# server.servlet.session.cookie.secure=false
# server.servlet.session.cookie.same-site=lax

# Optional third-party integrations
SLACK_TOKEN=
COINMARKETCAP_API_KEY=
GROQ_API_KEY=
