# Optional: serve the Socket.IO service on its own hostname (socket.${SITE_DOMAIN}).
# Not needed if you use the /socket.io/ location in nginx.conf.template.
#
#   envsubst '${SITE_DOMAIN} ${SOCKET_PORT}' \
#       < deploy/socket-nginx.conf.template > /etc/nginx/sites-available/socket
#   sudo certbot --nginx -d socket.${SITE_DOMAIN}     # adds the HTTPS (443) settings

server {
    listen 80;
    listen [::]:80;
    server_name socket.${SITE_DOMAIN};

    location /socket.io/ {
        proxy_pass http://localhost:${SOCKET_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location / {
        proxy_pass http://localhost:${SOCKET_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }
}
