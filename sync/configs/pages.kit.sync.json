{
  "name": "pages",
  "upstream": {
    "url": "https://github.com/Open-Coding-Society/pages.git",
    "branch": "main"
  },
  "catalog": {
    "file": "kits/catalog.json",
    "key": "pages"
  },
  "map": [
    {
      "upstream": "media/",
      "kit": "features/media-literacy/"
    },
    {
      "upstream": "hacks/",
      "kit": "features/hacks/"
    },
    {
      "upstream": "navigation/predictors/",
      "kit": "features/predictors/"
    }
  ],
  "exclude": [
    "/git",
    "/newsignup.html",
    "/linuxcyberA",
    "/.env",
    "/.hintrc",
    "/testing.html",
    "/assets/api/config.js",
    "/navigation/about.md",
    "/images/about",
    "/scripts/kasm_api_funcs.py",
    "/scripts/pull_issues.py",
    "/scripts/prs_issues*",
    "/CNAME",
    "/AGENTS.md",
    "/AGENTS_MD_DOCUMENTATION.md",
    "/instructions.md",
    "/sprintinfo.md",
    "/index3.md",
    "/omake",
    "/make-debug",
    "/peppamazegame",
    "/node_backend",
    "/design",
    "/docs",
    "/capstone",
    "/.devcontainer",
    "/.github",
    "/_docx",
    "/_posts/2024-06-25-RDS-and-Flask-Setup-*",
    "/_notebooks/CSP/big-ideas/big-idea-3-part-1-fundamentals/Period3",
    "/Gemfile.lock",
    "*.drawio",
    "*.docx",
    "*.log",
    "nohup.out",
    ".DS_Store",
    "/_includes/projects",
    "/_notebooks/projects",
    "/_posts/projects",
    "/_sass/projects",
    "/assets/js/projects",
    "/assets/css/projects",
    "/images/projects"
  ],
  "protect": [
    "_config.yml",
    "kits/**",
    "kit.sync.json",
    "kit.scrub-allow",
    "README.md",
    ".env.example",
    "assets/js/api/config.js",
    "_includes/head-custom.html",
    "scripts/apply_kit.py",
    ".github/workflows/**",
    "Makefile",
    "_data/kit_school.yml",
    "LICENSE",
    ".gitignore",
    "_projects/.makeprojects",
    "assets/js/kit-features.js",
    "assets/js/admin/**",
    "assets/js/vendor/**",
    "navigation/admin/**",
    "navigation/install.md",
    "index.md",
    "_includes/kit/**",
    "_includes/admin/**",
    "_includes/head.html",
    "_includes/nav/home.html",
    "_includes/nav/homejava.html",
    "_includes/slim_sidebar.html",
    "_includes/lesson-topbar.html",
    "_includes/lesson-submission-form.html",
    "_includes/lesson-submit-button.html",
    "_includes/challenge-submit-button.html",
    "_includes/post_category_blocks.html",
    "_includes/utterances.html",
    "_includes/aesthetihawk/sidebar.html",
    "_includes/runners/**",
    "_includes/themes/minima/**",
    "_layouts/aesthetihawk.html",
    "_layouts/calendar.html",
    "_layouts/cs-portfolio-admin.html",
    "_layouts/cs-portfolio-lesson.html",
    "_layouts/dashboard.html",
    "_layouts/lessonbase.html",
    "_layouts/lessonbasecapture.html",
    "_layouts/post.html",
    "_layouts/profile.html",
    "_layouts/chatbot.html",
    "_layouts/certchatbot.html",
    "_layouts/base_chatadpt.html",
    "_layouts/base_chatog.html",
    "scripts/convert_notebooks.py",
    "scripts/generate_sass_imports.py",
    "scripts/split_multi_course_files.py",
    "scripts/test_kit_runtime.js",
    "scripts/tests/**"
  ],
  "replace": [
    {
      "id": "js-pages-domain",
      "regex": true,
      "files": [
        "*.js",
        "*.mjs"
      ],
      "pattern": "([\"'`])https?://pages\\.opencodingsociety\\.com/",
      "replacement": "(window.baseurl || \"\") + \\1/",
      "description": "absolute links to the OCS site in JS -> the kit's own baseurl (window.baseurl is set in head-custom.html)"
    },
    {
      "id": "liquid-pages-domain",
      "regex": true,
      "files": [
        "*.md",
        "*.html",
        "*.ipynb",
        "*.markdown"
      ],
      "pattern": "https?://pages\\.opencodingsociety\\.com",
      "replacement": "{{site.baseurl}}",
      "description": "absolute links to the OCS site in pages/notebooks -> {{site.baseurl}}"
    },
    {
      "id": "liquid-flask-domain",
      "regex": true,
      "files": [
        "*.md",
        "*.html",
        "*.ipynb",
        "*.markdown"
      ],
      "pattern": "https?://flask\\.opencodingsociety\\.com",
      "replacement": "{{site.kit.backend.flask}}",
      "description": "OCS Flask backend -> kit.backend.flask in _config.yml (JS must use pythonURI from assets/js/api/config.js)"
    },
    {
      "id": "liquid-spring-domain",
      "regex": true,
      "files": [
        "*.md",
        "*.html",
        "*.ipynb",
        "*.markdown"
      ],
      "pattern": "https?://spring\\.opencodingsociety\\.com",
      "replacement": "{{site.kit.backend.spring}}",
      "description": "OCS Spring backend -> kit.backend.spring in _config.yml (JS must use javaURI from assets/js/api/config.js)"
    }
  ],
  "generated": [
    {
      "prefix": "assets/js/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "assets/css/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "images/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "_includes/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "_sass/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "_notebooks/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "_posts/projects/",
      "source": "_projects/*/{name}"
    },
    {
      "prefix": "assets/audio/projects/",
      "source": "_projects/*/{name}"
    }
  ],
  "scrub": {
    "max_file_kb": 10240,
    "pii_min_records": 10,
    "strip_metadata": true,
    "allowlist_file": "kit.scrub-allow",
    "allow": [
      {
        "path": "LICENSE",
        "rule": "deny:*",
        "reason": "license attribution to the original authors is required"
      },
      {
        "path": "kit.sync.json",
        "rule": "*",
        "reason": "this file names the terms it removes"
      },
      {
        "path": "kit.scrub-allow",
        "rule": "*",
        "reason": "allowlist itself"
      },
      {
        "path": "assets/js/admin/mock/*.json",
        "rule": "pii:handles",
        "reason": "admin dashboard mock data (?mock=1) with placeholder users like student01, marked 'Not real users'"
      }
    ],
    "skip": []
  },
